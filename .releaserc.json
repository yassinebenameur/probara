{
  "branches": [
    {
      "name": "dev",
      "channel": "alpha",
      "prerelease": "alpha"
    },
    {
      "name": "staging",
      "channel": "beta",
      "prerelease": "beta"
    },
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/release/update-helm-chart.sh ${nextRelease.version} && bash scripts/release/publish-helm-oci.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "helm/monitoring-platform/Chart.yaml"
        ],
        "message": "chore(release): ${nextRelease.version} [skip release]\\n\\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
