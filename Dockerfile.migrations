# Build stage
FROM golang:1.26.5-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache git

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build a simple migration runner
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /app/migrate -ldflags="-w -s" -tags 'postgres' ./cmd/migrate

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

# Copy binary and migrations
COPY --from=builder /app/migrate .
COPY shared/db/migrations ./migrations

# Run migrations
ENTRYPOINT ["./migrate"]
