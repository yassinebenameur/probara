# Build stage
# Runs on the build host and cross-compiles for the target platform, so a
# multi-arch build never compiles Go under QEMU (only the runtime stage does).
FROM --platform=$BUILDPLATFORM golang:1.26.5-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache git

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build a simple migration runner
# Release version stamped into shared/buildinfo (docker-build.yml passes the
# metadata action's version). Declared just before the build so a new version
# only invalidates this layer.
ARG VERSION=dev
ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -installsuffix cgo -o /app/migrate -ldflags="-w -s -X github.com/yassinebenameur/probara/shared/buildinfo.Version=${VERSION}" -tags 'postgres' ./cmd/migrate

# Runtime stage
FROM alpine:3.24

RUN apk --no-cache add ca-certificates

WORKDIR /app

# Copy binary and migrations
COPY --from=builder /app/migrate .
COPY shared/db/migrations ./migrations

# Run migrations
ENTRYPOINT ["./migrate"]
