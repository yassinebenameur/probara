vendor/
node_modules/
web/node_modules/

# Go workspace file
go.work

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Build artifacts
bin/
dist/
build/
coverage
coverage.html

# Next.js build output (and the .next.old.<ts> backups `next build` leaves behind —
# these embed app source in webpack caches and must never be committed)
.next/
**/.next/
.next.old.*
**/.next.old.*

# Compiled agent/collector binaries
static/agent/
static/collector/
collector/dist/
agent/uptime-agent
agent/probara-agent
status-page/main

# Docker volumes
postgres_data/
nats_data/

# Database dumps (`make db-backup` writes backup.sql to the repo root)
backup.sql
*.dump
*.sql.gz

# Kubernetes secrets
*.secret.yaml
secrets/
!shared/secrets/

# Environment files
.env
.env.local
.env.*.local
.envrc

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Test/report artifacts
web/playwright-report/
web/test-results/
.playwright-mcp/
# Ad-hoc screenshots and Playwright a11y-snapshot dumps land at the repo root
/*.png
