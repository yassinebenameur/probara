# Canonical origin of the deployed marketing/documentation site.
# Used for absolute metadata URLs when provided.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional path prefix for project-based static hosting, for example /probara.
# Leave empty when the site is hosted at the domain root.
NEXT_PUBLIC_BASE_PATH=

# Optional URL of a separately deployed Probara product UI. When set at build
# time, the header shows an "Open dashboard" link.
NEXT_PUBLIC_APP_URL=
