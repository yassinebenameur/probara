<!DOCTYPE html>
{{/*
  Email subscription pages of a status page (subscribe.go): the result of
  the subscribe form, and the page a confirmation or unsubscribe link from a
  subscriber mail opens. Served under the strict status-page CSP; its one
  script carries the per-response nonce (.Nonce, the placeholder csp.apply
  swaps). It shows only the page's
  title, logo and accent colour, never page data, and it is the same for
  built-in and custom templates.
*/}}
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>{{.Title}} · {{.Heading}}</title>
  <style>
    :root { color-scheme: light dark; --bg: #f6f7f9; --panel: #ffffff; --text: #111827; --muted: #6b7280; --edge: #d1d5db; --accent: {{.Accent}}; }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #0b0d12; --panel: #141821; --text: #e5e7eb; --muted: #9ca3af; --edge: #2a3140; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
    main { width: 100%; max-width: 420px; background: var(--panel); border: 1px solid var(--edge); border-radius: 14px; padding: 28px 24px; }
    .logo { display: block; width: 40px; height: 40px; object-fit: contain; margin-bottom: 14px; border-radius: 8px; }
    .page { margin: 0 0 4px; color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
    h1 { margin: 0 0 8px; font-size: 18px; font-weight: 600; }
    p { margin: 0 0 20px; color: var(--muted); font-size: 14px; }
    button { width: 100%; margin-bottom: 14px; padding: 10px 12px; border: 0; border-radius: 8px; background: var(--accent); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
    button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    a { color: inherit; font-size: 14px; }
  </style>
</head>
<body>
  <main>
    {{if .LogoURL}}<img class="logo" src="{{.LogoURL}}" alt="" />{{end}}
    <p class="page">{{.Title}}</p>
    <h1>{{.Heading}}</h1>
    <p role="status">{{.Message}}</p>
    {{if eq .State "landing"}}
    <form method="post" action="{{.Action}}" id="subscriptionForm" hidden>
      <input type="hidden" name="token" id="subscriptionToken" />
      <button type="submit">{{.Button}}</button>
    </form>
    <noscript><p>This step needs JavaScript: the link's key stays in your browser and is sent only when you press the button.</p></noscript>
    <p id="subscriptionMissing" hidden>This link is incomplete. Open it again from the email.</p>
    <script nonce="{{.Nonce}}">
      (function () {
        var token = decodeURIComponent((location.hash || '').replace(/^#/, ''));
        if (history.replaceState) {
          // Keep the key out of the address bar, bookmarks and history.
          history.replaceState(null, '', location.pathname + location.search);
        }
        if (!/^[A-Za-z0-9_-]{20,200}$/.test(token)) {
          document.getElementById('subscriptionMissing').hidden = false;
          return;
        }
        document.getElementById('subscriptionToken').value = token;
        document.getElementById('subscriptionForm').hidden = false;
      })();
    </script>
    {{end}}
    {{if .PageURL}}<a href="{{.PageURL}}">Back to the status page</a>{{end}}
  </main>
</body>
</html>
