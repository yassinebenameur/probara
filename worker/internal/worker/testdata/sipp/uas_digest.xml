<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- Digest-authenticating callee for sip_invite_integration_test.go. The
     first INVITE draws a 401; SIPp's own verifyauth checks the retried
     INVITE against user "probara" / password "probara-secret" and answers
     403 when it does not verify. On the answered path the 2xx ACK must carry
     the INVITE's Authorization (RFC 3261 22.1); the ereg check fails the
     SIPp call when it does not. -->
<scenario name="Probara digest-authenticating UAS">
  <recv request="INVITE" />

  <send>
    <![CDATA[

      SIP/2.0 401 Unauthorized
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="probara.test", nonce="[pid]n[call_number]", qop="auth", algorithm=MD5
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK" />

  <recv request="INVITE">
    <action>
      <verifyauth assign_to="authvalid" username="probara" password="probara-secret" />
    </action>
  </recv>

  <nop hide="true" test="authvalid" next="authorized" />

  <send>
    <![CDATA[

      SIP/2.0 403 Forbidden
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK" next="done" />

  <label id="authorized" />

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000

    ]]>
  </send>

  <recv request="ACK">
    <action>
      <ereg regexp="Digest .*username=\"probara\"" search_in="hdr" header="Authorization:" check_it="true" assign_to="ackauth" />
    </action>
  </recv>

  <recv request="BYE" />

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <label id="done" />

  <!-- Check-only captures: declare them used. -->
  <Reference variables="ackauth" />
</scenario>
