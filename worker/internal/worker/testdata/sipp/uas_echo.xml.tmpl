<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- Media callee for sip_invite_integration_test.go: uas_answer.xml with
     the SDP templated by startSIPpUASMedia. __MEDIA_ADDR__:__MEDIA_PORT__ is
     the host loopback port Docker publishes to SIPp's -mp socket (host and
     container port are equal, so the SDP can name it), and __PT__/__CODEC__
     the one payload type answered. SIPp's own [media_ip] is its container
     address, which a macOS host cannot reach. The 2xx ACK and the BYE stay
     mandatory, so SIPp's exit code still says the call completed after the
     media. -->
<scenario name="Probara media UAS">
  <recv request="INVITE" />

  <send>
    <![CDATA[

      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP4 __MEDIA_ADDR__
      t=0 0
      m=audio __MEDIA_PORT__ RTP/AVP __PT__
      a=rtpmap:__PT__ __CODEC__/8000
      a=ptime:20

    ]]>
  </send>

  <recv request="ACK">
    <action>
      <ereg regexp="^ *1 ACK$" search_in="hdr" header="CSeq:" check_it="true" assign_to="ackcseq" />
    </action>
  </recv>

  <recv request="BYE">
    <action>
      <ereg regexp="^ *2 BYE$" search_in="hdr" header="CSeq:" check_it="true" assign_to="byecseq" />
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- Check-only captures: declare them used. -->
  <Reference variables="ackcseq,byecseq" />
</scenario>
