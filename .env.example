# Core service settings
HTTP_PORT=8080
METRICS_PORT=9090
LOG_LEVEL=info
POSTGRES_URL=postgres://probara:probara@localhost:5432/probara?sslmode=disable
NATS_URL=nats://localhost:4222

# Admin auth (server-side)
ADMIN_JWT_SECRET=change-me-in-production-jwt-secret-minimum-32-chars
ADMIN_ACCESS_TTL_MINUTES=15
ADMIN_REFRESH_TTL_DAYS=30
ADMIN_COOKIE_SECURE=false

# At-rest encryption for monitor/channel config secrets (DB passwords,
# connection strings, webhook tokens). 32 random bytes, base64-encoded:
#   openssl rand -base64 32
# Unset = encryption disabled (dev only). Needed by api, worker, and alerter.
# Losing this key makes stored secrets unreadable - back it up.
#PROBARA_SECRETS_KEY=

# Local AI is enabled by default: a bundled CPU model in the local-ai container
# (no external LLM calls, no provider credentials). Read by api, worker and
# the local-ai container; the alerter never calls local AI but reads
# LOCAL_AI_DISABLED and AI_TRIAGE_ENABLED, and with either switch off it sends
# no suspected-cause follow-ups.
# true turns it off for every workspace and makes the make targets skip the
# container (plain `docker compose up` still pulls or builds it).
#LOCAL_AI_DISABLED=false
# Automatic alert triage kill switch (worker, alerter and api): false stops new
# triage claims, and queued rows drain as skipped.
#AI_TRIAGE_ENABLED=true
#LOCAL_AI_URL=http://127.0.0.1:8090
# Internal bearer token shared by api, worker and the local-ai container (at
# least 16 characters). Unset: `make start-all-local` generates a per-checkout
# one in the gitignored .dev-local-ai-token; plain Compose falls back to a
# fixed, PUBLIC development token, acceptable only because its port is bound to
# loopback. Set your own (openssl rand -hex 32) on any shared host.
#LOCAL_AI_TOKEN=
#LOCAL_AI_TIMEOUT_SECONDS=90
# Inference container (local-ai only). Image to pull before building one from
# ai-service/ (a build succeeds only for a release-approved artifact; the make
# targets keep a failed local-ai build from blocking the platform).
#LOCAL_AI_IMAGE=ghcr.io/yassinebenameur/probara-local-ai:latest
# CPU limit, at most the Docker host's CPU count, and threads (1-4, at most the
# CPU limit). Unset, the make targets and start-local-services.sh use
# min(host CPUs, 4) for both; plain Compose uses 4.
#LOCAL_AI_CPUS=4
#LOCAL_AI_THREADS=4
#LOCAL_AI_QUEUE_CAPACITY=4
# Wait for the executing batch before a 429; keep below LOCAL_AI_TIMEOUT_SECONDS.
#LOCAL_AI_QUEUE_TIMEOUT_SECONDS=60
# A batch running longer is wedged: /healthz answers 503.
#LOCAL_AI_MAX_INFERENCE_SECONDS=120
# NATS plumbing for the async analysis job (defaults are fine):
#AI_RCA_STREAM=AI_RCA
#AI_RCA_SUBJECT=ai.rca.jobs
#AI_RCA_CONSUMER_NAME=ai-rca-workers
# Same for alert triage; stream and subject must differ from AI_RCA_* or the
# worker refuses to start.
#AI_TRIAGE_STREAM=AI_TRIAGE
#AI_TRIAGE_SUBJECT=ai.triage.jobs
#AI_TRIAGE_CONSUMER_NAME=ai-triage-workers

# Private locations (multi-location checks).
# Workers are NATS-only: they publish results to CHECK_RESULT_SUBJECT and the
# scheduler-side ingest consumer persists them. A worker with
# WORKER_LOCATION_ID set consumes only that location's job subject
# (check.jobs.loc.<uuid>) and needs NO POSTGRES_URL — only NATS reachability.
# The UUID comes from the Locations page in the UI.
#WORKER_LOCATION_ID=
# NATS address reachable from remote networks, baked into the deploy snippets
# the API generates (api only). Enable NATS auth/TLS before exposing it.
#PUBLIC_NATS_URL=nats://nats.example.com:4222
# Results-ingest plumbing (defaults are fine):
#CHECK_RESULT_STREAM=CHECK_RESULTS
#CHECK_RESULT_SUBJECT=check.results
#RESULT_INGEST_CONSUMER_NAME=result-ingest
#RESULT_INGEST_CONCURRENCY=10
#RESULT_INGEST_ENABLED=true
# Filterless pre-locations consumers the scheduler deletes on startup:
#CHECK_JOB_LEGACY_CONSUMERS=check-workers,worker

# Inter-location connectivity mesh (scheduler + api; defaults are fine).
# Locations opt in by setting a mesh endpoint (host:port of the worker's
# HTTP_PORT, reachable from the other locations) on the Locations page; every
# participating location then probes every other one on this cadence.
#MESH_ENABLED=true
#MESH_PROBE_INTERVAL_SECONDS=30
#MESH_PROBE_TIMEOUT_SECONDS=5
#MESH_FAILURE_THRESHOLD=3
#MESH_SCHEDULE_BATCH_SIZE=500

# Audit log retention in days (0 = keep forever). Applies to the API service.
#AUDIT_RETENTION_DAYS=365

# OIDC SSO login (api service). Redirect URL defaults to
# PUBLIC_BASE_URL + /api/v1/auth/oidc/callback. For local dev run the dex
# test IdP: docker compose --profile sso up dex  (admin@example.com/password)
#OIDC_ENABLED=true
#OIDC_ISSUER_URL=http://localhost:5556/dex
#OIDC_CLIENT_ID=probara
#OIDC_CLIENT_SECRET=probara-dex-secret
#OIDC_REDIRECT_URL=http://localhost:3000/api/v1/auth/oidc/callback
# Add "groups" to OIDC_SCOPES when using group→role mappings (some IdPs,
# e.g. Okta, only emit the groups claim when the scope is requested).
#OIDC_SCOPES=openid profile email
# ID-token claim holding the user's IdP groups (group→role mappings).
#OIDC_GROUPS_CLAIM=groups
#OIDC_PROVIDER_LABEL=SSO
#OIDC_JIT_PROVISION=true
#OIDC_JIT_DEFAULT_ROLE=viewer
#OIDC_JIT_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
