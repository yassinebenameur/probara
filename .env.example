# Core service settings
HTTP_PORT=8080
METRICS_PORT=9090
LOG_LEVEL=info
POSTGRES_URL=postgres://probara:probara@localhost:5432/probara?sslmode=disable
NATS_URL=nats://localhost:4222

# Admin auth (server-side)
ADMIN_JWT_SECRET=change-me-in-production-jwt-secret-minimum-32-chars
ADMIN_ACCESS_TTL_MINUTES=15
ADMIN_REFRESH_TTL_DAYS=30
ADMIN_COOKIE_SECURE=false

# At-rest encryption for monitor/channel config secrets (DB passwords,
# connection strings, webhook tokens). 32 random bytes, base64-encoded:
#   openssl rand -base64 32
# Unset = encryption disabled (dev only). Needed by api, worker, and alerter.
# Losing this key makes stored secrets unreadable - back it up.
#PROBARA_SECRETS_KEY=

# AI root cause analysis for incidents (provider-agnostic LLM).
# Wire in whatever LLM you run via the OpenAI-compatible Chat Completions API:
# OpenAI, Azure OpenAI, a gateway, or a local runtime (Ollama, vLLM, LM Studio).
# Unset LLM_BASE_URL = feature disabled (the "Analyze" endpoint returns
# "not configured"). Needed by the worker (consumer) and api (job publisher).
#LLM_PROVIDER=openai_compat
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_API_KEY=
#LLM_MODEL=gpt-4o-mini
#LLM_MAX_TOKENS=1024
#LLM_TIMEOUT_SECONDS=60
# response_format sent to the provider: off (default) | json_object | json_schema.
# Leave off for the broadest compatibility (some servers, e.g. certain SGLang
# builds, error on response_format); the prompt still requests JSON and the
# result is parsed defensively. Opt in where the endpoint supports it.
#LLM_JSON_MODE=off
# NATS plumbing for the async analysis job (defaults are fine):
#AI_RCA_STREAM=AI_RCA
#AI_RCA_SUBJECT=ai.rca.jobs
#AI_RCA_CONSUMER_NAME=ai-rca-workers
